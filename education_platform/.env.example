# 复制为 .env 后填写真实配置；.env 已被 Git 忽略，不会上传到远端。
# Django 生产配置
DJANGO_SECRET_KEY=请替换为至少50位的服务器专用随机字符串
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=你的域名,服务器公网IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://你的域名
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# HTTPS 稳定运行后再逐步启用 HSTS；首次部署保持 0。
DJANGO_SECURE_HSTS_SECONDS=0

# DeepSeek API Key：只保存在服务器 .env，不要写进代码或提交到 Git。
# 密钥管理：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
