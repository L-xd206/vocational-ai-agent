[Unit]
Description=Vocational AI Django via uWSGI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/vocational-ai-agent/education_platform
ExecStart=/srv/vocational-ai-agent/education_platform/.venv/bin/uwsgi --ini /srv/vocational-ai-agent/education_platform/deploy/uwsgi.ini
Restart=always
RestartSec=5
KillSignal=SIGQUIT

[Install]
WantedBy=multi-user.target
